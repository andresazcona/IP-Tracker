    {
      "name": "Device Management",
      "item": [
        {
          "name": "Create Test Device",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const timestamp = Date.now();",
                  "pm.environment.set('testDeviceName', `TestDevice${timestamp}`);",
                  "pm.environment.set('testDeviceMac', `AA:BB:CC:DD:EE:${timestamp.toString().slice(-2)}`);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Device created successfully', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.message).to.include('created');",
                  "    pm.expect(responseJson.device).to.have.property('id');",
                  "    pm.environment.set('testDeviceId', responseJson.device.id);",
                  "});",
                  "",
                  "pm.test('Device has correct information', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.device.device_name).to.eql(pm.environment.get('testDeviceName'));",
                  "    pm.expect(responseJson.device.device_type).to.eql('raspberry_pi');",
                  "    pm.expect(responseJson.device.location).to.eql('Test Lab');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
