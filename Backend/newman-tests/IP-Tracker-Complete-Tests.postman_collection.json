            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_name\": \"{{testDeviceName}}\",\n  \"device_type\": \"raspberry_pi\",\n  \"location\": \"Test Lab\",\n  \"description\": \"Test device for Newman testing\",\n  \"mac_address\": \"{{testDeviceMac}}\",\n  \"serial_number\": \"TEST001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/devices",
              "host": ["{{baseUrl}}"],
              "path": ["api", "devices"]
            }
