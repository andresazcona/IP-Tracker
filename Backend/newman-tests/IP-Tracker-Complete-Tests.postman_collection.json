    {
      "name": "Hard Delete Tests",
      "item": [
        {
          "name": "Hard Delete Device",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Device deletion confirmed', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.message).to.include('deleted');",
                  "    pm.expect(responseJson.device_id).to.eql(pm.environment.get('testDeviceId'));",
                  "});",
                  "",
                  "// Wait for deletion to process",
                  "setTimeout(() => {}, 100);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
