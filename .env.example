# Configuración de Base de Datos PostgreSQL
DB_NAME=ip_tracker
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Configuración JWT
JWT_SECRET=your_super_secure_jwt_secret_here_minimum_32_characters
JWT_EXPIRES_IN=24h

# Puerto del Backend (opcional, por defecto 3000)
# PORT=3000

# Ambiente
# NODE_ENV=production
